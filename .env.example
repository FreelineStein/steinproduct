# Copy to .env.local for local builds. On Vercel, set the same two variables
# in Project Settings > Environment Variables for the Production and Preview
# environments; the site is a static export, so NEXT_PUBLIC_ values are
# inlined at build time and a missing value ships as `undefined`.
#
# Project token: PostHog > Project settings > General. It is public by design.
# Host: the managed reverse proxy (PostHog > Organization settings > Managed
# reverse proxy), or https://us.i.posthog.com / https://eu.i.posthog.com direct.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://orbit.steinproduct.com
